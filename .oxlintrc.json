{
	"extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
	"ignorePatterns": ["**/dist/**", "repos/**"],
	"rules": {
		"typescript/no-explicit-any": "error",
		"typescript/consistent-type-imports": "error"
	},
	"overrides": [
		{
			"files": ["packages/*/test/**/*.ts"],
			"rules": {
				"effecttsgo/async-function": "off",
				"effecttsgo/global-fetch": "off",
				"effecttsgo/global-timers": "off",
				"effecttsgo/new-promise": "off",
				"effecttsgo/node-builtin-import": "off",
				"effecttsgo/process-env": "off"
			}
		},
		{
			"files": ["scripts/**/*.ts"],
			"rules": {
				"effecttsgo/global-console": "off",
				"effecttsgo/node-builtin-import": "off"
			}
		},
		{
			"files": ["packages/server/src/page-comments.js"],
			"rules": {
				"effecttsgo/async-function": "off",
				"effecttsgo/crypto-random-uuid": "off",
				"effecttsgo/global-date": "off",
				"effecttsgo/global-fetch": "off",
				"effecttsgo/global-random": "off",
				"effecttsgo/global-timers": "off"
			}
		},
		{
			"files": ["packages/ui/vite.config.ts"],
			"rules": {
				"effecttsgo/process-env": "off"
			}
		}
	]
}
